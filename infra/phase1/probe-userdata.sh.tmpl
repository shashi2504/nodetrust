#!/bin/bash
# First-boot user data for the Phase 1 probe instance (generated by
# 02-launch-probe.sh). Installs tpm2-tools, writes the probe files, turns IMA
# on through the kernel command line, and reboots once.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y tpm2-tools openssl python3

install -d -m 0700 /opt/nodetrust
base64 -d <<'NT_PROBE_EOF' | gunzip >/opt/nodetrust/probe.sh
@@PROBE_SH_B64@@
NT_PROBE_EOF
base64 -d <<'NT_REPLAY_EOF' | gunzip >/opt/nodetrust/ima_replay.py
@@IMA_REPLAY_B64@@
NT_REPLAY_EOF
chmod 0700 /opt/nodetrust/probe.sh /opt/nodetrust/ima_replay.py

# Probe-only IMA policy: the built-in "tcb" policy. The golden AMI (step 1.2)
# replaces it with the custom policy from blueprint Section 6.4.
cat >/etc/default/grub.d/60-nodetrust-ima.cfg <<'EOF'
GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT ima_policy=tcb ima_template=ima-ng ima_hash=sha256"
EOF
update-grub

touch /opt/nodetrust/.firstboot-done
reboot
