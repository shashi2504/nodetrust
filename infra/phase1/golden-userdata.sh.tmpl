#!/bin/bash
# User data for a golden-AMI test node (generated by 02-launch-probe.sh with
# PROBE_MODE=golden). The AMI already has IMA, the policy and tpm2-tools, so
# this only drops the probe files. No reboot.
set -euxo pipefail

install -d -m 0700 /opt/nodetrust
base64 -d <<'NT_PROBE_EOF' | gunzip >/opt/nodetrust/probe.sh
@@PROBE_SH_B64@@
NT_PROBE_EOF
base64 -d <<'NT_REPLAY_EOF' | gunzip >/opt/nodetrust/ima_replay.py
@@IMA_REPLAY_B64@@
NT_REPLAY_EOF
chmod 0700 /opt/nodetrust/probe.sh /opt/nodetrust/ima_replay.py
touch /opt/nodetrust/.firstboot-done
