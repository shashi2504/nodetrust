#!/bin/bash
# Control plane bootstrap, rendered by Terraform (compute.tf).
# Note for editors: $${...} is Terraform interpolation in this file; bash
# variables are written as plain $VAR without braces.
set -euxo pipefail
exec > >(tee -a /var/log/nodetrust-bootstrap.log) 2>&1

IMDS=http://169.254.169.254/latest
TOKEN=$(curl -sf -X PUT "$IMDS/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
IID=$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" "$IMDS/meta-data/instance-id")
AZ=$(curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" "$IMDS/meta-data/placement/availability-zone")

# Cluster CA generated by Terraform, so workers can pin it.
install -d -m 0755 /etc/kubernetes/pki
cat >/etc/kubernetes/pki/ca.crt <<'NT_EOF'
${ca_cert_pem}
NT_EOF
install -m 0600 /dev/null /etc/kubernetes/pki/ca.key
cat >/etc/kubernetes/pki/ca.key <<'NT_EOF'
${ca_key_pem}
NT_EOF

cat >/etc/kubernetes/nodetrust-kubeadm.yaml <<NT_EOF
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
bootstrapTokens:
- token: "${token}"
  ttl: "0s"
  usages: [signing, authentication]
  groups: [system:bootstrappers:kubeadm:default-node-token]
localAPIEndpoint:
  advertiseAddress: ${cp_ip}
  bindPort: 6443
nodeRegistration:
  kubeletExtraArgs:
  - name: provider-id
    value: aws:///$AZ/$IID
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
networking:
  podSubnet: ${pod_cidr}
apiServer:
  certSANs: ["127.0.0.1", "localhost", "${cp_ip}"]
NT_EOF

kubeadm init --config /etc/kubernetes/nodetrust-kubeadm.yaml
export KUBECONFIG=/etc/kubernetes/admin.conf

# Calico through the tigera operator: VXLAN, iptables dataplane (not eBPF,
# so the peer-side deny in blueprint 10.6 sees pod traffic).
kubectl create -f "https://raw.githubusercontent.com/projectcalico/calico/${calico_version}/manifests/tigera-operator.yaml"
# The operator manifest carries no CRDs: the operator pod creates them when it
# starts, after pulling its image. Allow up to 5 minutes.
for _ in $(seq 1 60); do
  kubectl get crd installations.operator.tigera.io >/dev/null 2>&1 && break
  sleep 5
done
kubectl wait --for condition=established crd/installations.operator.tigera.io --timeout=120s
cat <<'NT_EOF' | kubectl create -f -
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    linuxDataplane: Iptables
    # Pod traffic uses VXLAN, so BGP (BIRD) is unused. Left on, calico-node
    # waits for BGP peers on TCP 179, which the security groups do not open,
    # and never reports ready (seen 2026-11-15 with v3.32.4).
    bgp: Disabled
    ipPools:
    - name: default-ipv4-ippool
      cidr: ${pod_cidr}
      encapsulation: VXLAN
      natOutgoing: Enabled
      nodeSelector: all()
NT_EOF

touch /var/lib/nodetrust-bootstrap-done
echo "nodetrust: control plane bootstrap finished"
